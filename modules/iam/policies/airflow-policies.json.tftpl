[
  {
    "Effect": "Allow",
    "Action": [
      "s3:GetObject",
      "s3:PutObject",
      "s3:DeleteObject",
      "s3:ListBucket"
    ],
    "Resource": [
      "arn:aws:s3:::${project_name}-${environment}-*",
      "arn:aws:s3:::${project_name}-${environment}-*/*"
    ]
  },
  {
    "Effect": "Allow",
    "Action": [
      "kms:Decrypt",
      "kms:GenerateDataKey"
    ],
    "Resource": "arn:aws:kms:*:*:key/*",
    "Condition": {
      "StringLike": {
        "kms:ViaService": "s3.*.amazonaws.com"
      }
    }
  },
  {
    "Effect": "Allow",
    "Action": [
      "secretsmanager:GetSecretValue"
    ],
    "Resource": "arn:aws:secretsmanager:*:*:secret:${project_name}/${environment}/*"
  },
  {
    "Effect": "Allow",
    "Action": [
      "ecs:RunTask",
      "ecs:DescribeTasks",
      "ecs:StopTask"
    ],
    "Resource": [
      "arn:aws:ecs:*:*:task-definition/*-${environment}:*",
      "arn:aws:ecs:*:*:task/*"
    ]
  },
  {
    "Effect": "Allow",
    "Action": "iam:PassRole",
    "Resource": "arn:aws:iam::*:role/*",
    "Condition": {
      "StringLike": {
        "iam:PassedToService": "ecs-tasks.amazonaws.com"
      }
    }
  },
  {
    "Effect": "Allow",
    "Action": [
      "logs:CreateLogStream",
      "logs:PutLogEvents"
    ],
    "Resource": "arn:aws:logs:*:*:log-group:/ecs/*-${environment}:*"
  }
]
